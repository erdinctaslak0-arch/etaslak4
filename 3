import {
  WorkflowEntrypoint,
  WorkflowEvent,
  WorkflowStep,
} from "cloudflare:workers";

type Env = {
  MEXC_TRADE: Workflow;
  MEXC_API_KEY: string;
  MEXC_SECRET_KEY: string;
};

type Slot = {
  sym: string;
  tf: string;
  amount: number;
  lev: number;
  dir: "BOTH" | "LONG_ONLY" | "SHORT_ONLY";
  src: "last" | "fair" | "index";
  sys: "mema" | "mpos" | "kpos" | "szow" | "rszow";
  emaLen: number;
  szoLen: number;
  scope: "own" | "6tf";
  htfs: string[];
  entryMode: "close" | "live";
  exitMode: "close" | "live";
};

type Candle = { time: number; open: number; high: number; low: number; close: number; volume: number };
type Signal = { time: number; type: "BUY" | "SELL" | "EX"; price: number };

const TF_SEC: Record<string, number> = {
  "1m": 60, "5m": 300, "10m": 600, "15m": 900, "30m": 1800,
  "1h": 3600, "2h": 7200, "3h": 10800, "4h": 14400, "6h": 21600,
  "8h": 28800, "12h": 43200, "1d": 86400, "2d": 172800, "3d": 259200, "5d": 432000,
};
const NATIVE: Record<string, string> = {
  "1m": "Min1", "5m": "Min5", "15m": "Min15", "30m": "Min30",
  "1h": "Min60", "4h": "Hour4", "8h": "Hour8", "1d": "Day1",
};
const BASE: Record<string, string> = {
  "10m": "5m", "2h": "1h", "3h": "1h", "6h": "1h", "12h": "4h",
  "2d": "1d", "3d": "1d", "5d": "1d",
};

function baseTf(tf: string): string {
  return NATIVE[tf] ? tf : BASE[tf];
}

function aggregate(c: Candle[], sec: number): Candle[] {
  const out: Candle[] = [];
  for (const k of c) {
    const t = Math.floor(k.time / sec) * sec;
    const l = out[out.length - 1];
    if (l && l.time === t) {
      l.high = Math.max(l.high, k.high);
      l.low = Math.min(l.low, k.low);
      l.close = k.close;
      l.volume += k.volume;
    } else {
      out.push({ ...k, time: t });
    }
  }
  return out;
}

async function mexcSigned(
  env: Env,
  path: string,
  params: Record<string, string | number>,
  method: "GET" | "POST" = "GET",
): Promise<any> {
  const base = "https://contract.mexc.com";
  const ts = Date.now().toString();
  const all = { ...params, timestamp: ts };
  const qs = new URLSearchParams(
    Object.fromEntries(Object.entries(all).map(([k, v]) => [k, String(v)])),
  ).toString();
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(env.MEXC_SECRET_KEY),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"],
  );
  const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(qs));
  const sigHex = [...new Uint8Array(sig)].map((b) => b.toString(16).padStart(2, "0")).join("");
  const url = `${base}${path}?${qs}&signature=${sigHex}`;
  const res = await fetch(url, {
    method,
    headers: { "X-MEXC-APIKEY": env.MEXC_API_KEY, "Content-Type": "application/json" },
  });
  const d = await res.json();
  if (!d.success) throw new Error(`MEXC ${path}: ${d.message || d.code || "hata"}`);
  return d.data;
}

async function fetchKlines(symbol: string, interval: string, start: number, end: number): Promise<Candle[]> {
  const qs = new URLSearchParams({
    symbol, interval,
    start: String(Math.floor(start)),
    end: String(Math.floor(end)),
  });
  const res = await fetch(`https://contract.mexc.com/api/v1/contract/kline/${symbol}?${qs}`);
  const d = await res.json() as any;
  if (!d.success || !d.data?.time) return [];
  const out: Candle[] = [];
  for (let i = 0; i < d.data.time.length; i++) {
    out.push({
      time: d.data.time[i],
      open: +d.data.open[i],
      high: +d.data.high[i],
      low: +d.data.low[i],
      close: +d.data.close[i],
      volume: +d.data.vol[i],
    });
  }
  return out;
}

async function fetchRange(symbol: string, tf: string, since: number): Promise<Candle[]> {
  const iv = NATIVE[tf];
  if (!iv) throw new Error(`TF ${tf} desteklenmiyor`);
  const sec = TF_SEC[tf];
  const out: Candle[] = [];
  let from = since;
  const now = Date.now() / 1000;
  for (let n = 0; n < 20; n++) {
    const rows = await fetchKlines(symbol, iv, from, Math.min(now, from + 1999 * sec));
    if (!rows.length) {
      if (from + 2000 * sec < now) { from += 2000 * sec; continue; }
      break;
    }
    mergeInto(out, rows);
    const last = rows[rows.length - 1].time;
    if (last + sec >= now - sec || last < from) break;
    from = last + sec;
  }
  return out;
}

function mergeInto(a: Candle[], b: Candle[]) {
  const m = new Map(a.map((c) => [c.time, c]));
  for (const c of b) m.set(c.time, c);
  a.length = 0;
  Array.from(m.values()).sort((x, y) => x.time - y.time).forEach((c) => a.push(c));
}

async function getTicker(symbol: string): Promise<{ last: number; fair: number; index: number }> {
  const res = await fetch(`https://contract.mexc.com/api/v1/contract/ticker?symbol=${symbol}`);
  const d = await res.json() as any;
  if (!d.success) throw new Error("ticker yok");
  return { last: +d.data.lastPrice, fair: +d.data.fairPrice, index: +d.data.indexPrice };
}

function memaSignals(candles: Candle[], n: number): Signal[] {
  if (candles.length < n + 1) return [];
  const a = 2 / (n + 1);
  let eu: number | null = null;
  let ed: number | null = null;
  let lu = 0, ld = 0;
  let pos = 0;
  let lastSigT = -1;
  const sigs: Signal[] = [];
  for (let i = 0; i < candles.length; i++) {
    const c = candles[i];
    if (i > 0) {
      eu = eu === null ? lu : a * lu + (1 - a) * eu;
      ed = ed === null ? ld : a * ld + (1 - a) * ed;
    }
    const ir = c.high > c.low ? (c.close - c.low) / (c.high - c.low) : 0;
    const v = c.volume || 0;
    lu = v * ir;
    ld = v * (1 - ir);
    if (c.high <= c.low && eu === null) continue;
    const euV = eu === null ? lu : a * lu + (1 - a) * eu;
    const edV = ed === null ? ld : a * ld + (1 - a) * ed;
    const dir = euV > edV ? 1 : edV > euV ? -1 : 0;
    const allBuy = dir === 1;
    const allSell = dir === -1;
    const buy = allBuy && pos !== 1 && lastSigT !== c.time;
    const sell = allSell && pos !== -1 && lastSigT !== c.time;
    const ex = (pos === 1 && !allBuy || pos === -1 && !allSell) && !buy && !sell && lastSigT !== c.time;
    if (buy) { sigs.push({ time: c.time, type: "BUY", price: c.close }); pos = 1; lastSigT = c.time; }
    else if (sell) { sigs.push({ time: c.time, type: "SELL", price: c.close }); pos = -1; lastSigT = c.time; }
    else if (ex) { sigs.push({ time: c.time, type: "EX", price: c.close }); pos = 0; lastSigT = c.time; }
  }
  return sigs;
}

async function getContractDetail(symbol: string) {
  const res = await fetch(`https://contract.mexc.com/api/v1/contract/detail?symbol=${symbol}`);
  const d = await res.json() as any;
  if (!d.success) throw new Error("detail yok");
  return {
    priceUnit: +d.data.priceUnit || 1e-8,
    contractSize: +d.data.contractSize || 1,
    minVol: +d.data.minVol || 1,
    maxLeverage: +d.data.maxLeverage || 100,
  };
}

async function setLeverage(env: Env, symbol: string, leverage: number) {
  try {
    await mexcSigned(env, "/api/v1/contract/position_leverage", { symbol, leverage }, "POST");
  } catch (e) { /* zaten ayarlı */ }
}

async function placeOrder(
  env: Env, symbol: string, side: "BUY" | "SELL",
  quantity: number, leverage: number, reduceOnly = false,
) {
  const params: Record<string, string | number> = {
    symbol, side, vol: quantity, leverage, orderType: "MARKET",
  };
  if (reduceOnly) params.reduceOnly = "true";
  return mexcSigned(env, "/api/v1/contract/order_submit", params, "POST");
}

async function getPosition(env: Env, symbol: string) {
  const d = await mexcSigned(env, "/api/v1/contract/position", { symbol });
  const pos = Array.isArray(d) ? d.find((p: any) => p.symbol === symbol) : null;
  if (!pos || +pos.positionType === 0 || +pos.vol === 0) return null;
  return { side: +pos.positionType === 1 ? "LONG" : "SHORT", vol: +pos.vol, entry: +pos.avgPrice };
}

const DEFAULT_SLOTS: Slot[] = [
  {
    sym: "PEPE_USDT", tf: "5m", amount: 10, lev: 10, dir: "BOTH", src: "last",
    sys: "mema", emaLen: 20, szoLen: 2, scope: "own", htfs: [],
    entryMode: "close", exitMode: "close",
  },
];

export class MexcTradeWorkflow extends WorkflowEntrypoint<Env, { slots?: Slot[] }> {
  async run(event: WorkflowEvent<{ slots?: Slot[] }>, step: WorkflowStep) {
    const slots = event.payload.slots?.length ? event.payload.slots : DEFAULT_SLOTS;
    const results: any[] = [];
    for (const slot of slots) {
      const r = await step.do(`trade ${slot.sym} ${slot.tf}`, async () => {
        return this.runSlot(slot);
      });
      results.push({ sym: slot.sym, ...r });
    }
    return { runAt: new Date().toISOString(), results };
  }

  async runSlot(slot: Slot): Promise<any> {
    const now = Date.now() / 1000;
    const es = TF_SEC[slot.tf];
    const bars = 1500;
    const since = Math.floor(now / es) * es - bars * es;

    const base = baseTf(slot.tf);
    let candles = await fetchRange(slot.sym, base, since);
    if (base !== slot.tf) candles = aggregate(candles, es);

    const sigs = memaSignals(candles, slot.emaLen);
    const last = sigs[sigs.length - 1];
    if (!last) return { action: "none", reason: "sinyal yok" };

    const detail = await getContractDetail(slot.sym);
    const pos = await getPosition(this.env, slot.sym);
    const ticker = await getTicker(slot.sym);
    const price = ticker[slot.src] || ticker.last;

    if (last.type === "EX" && pos) {
      await setLeverage(this.env, slot.sym, Math.min(slot.lev, detail.maxLeverage));
      await placeOrder(this.env, slot.sym, pos.side === "LONG" ? "SELL" : "BUY", pos.vol, slot.lev, true);
      return { action: "EX", price, closedSide: pos.side };
    }

    const side = last.type === "BUY" ? "LONG" : "SHORT";
    const dirOk = slot.dir === "BOTH" || (side === "LONG" ? slot.dir === "LONG_ONLY" : slot.dir === "SHORT_ONLY");
    if (!dirOk) return { action: "skip", reason: `yön filtresi: ${slot.dir}` };

    if (pos && pos.side === side) return { action: "none", reason: "zaten aynı yönde" };

    const lev = Math.min(slot.lev, detail.maxLeverage);
    await setLeverage(this.env, slot.sym, lev);

    if (pos) {
      await placeOrder(this.env, slot.sym, pos.side === "LONG" ? "SELL" : "BUY", pos.vol, lev, true);
    }

    const vol = Math.max(detail.minVol, Math.floor((slot.amount * lev) / (price * detail.contractSize)));
    await placeOrder(this.env, slot.sym, side === "LONG" ? "BUY" : "SELL", vol, lev, false);

    return { action: last.type, side, vol, price, lev };
  }
}

export default {
  async fetch(req: Request, env: Env): Promise<Response> {
    const url = new URL(req.url);
    if (url.pathname === "/trigger") {
      const body = await req.json().catch(() => ({}));
      const instance = await env.MEXC_TRADE.create({ id: crypto.randomUUID(), params: body });
      return Response.json({ id: instance.id, status: await instance.status() });
    }
    if (url.pathname === "/status") {
      const id = url.searchParams.get("instanceId");
      if (!id) return Response.json({ error: "instanceId gerekli" }, { status: 400 });
      const instance = await env.MEXC_TRADE.get(id);
      return Response.json({ status: await instance.status() });
    }
    return Response.json({
      service: "mexc-trade-workflow",
      trigger: "POST /trigger  { slots?: [...] }",
      status: "GET /status?instanceId=xxx",
      schedule: "her 5 dakika (cron: */5 * * * *)",
    });
  },
};
